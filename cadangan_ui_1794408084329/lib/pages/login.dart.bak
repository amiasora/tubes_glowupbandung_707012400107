
import 'package:flutter/material.dart';

import '../services/sesi_akun.dart';

class HalamanLogin extends StatefulWidget {
  const HalamanLogin({super.key});

  @override
  State<HalamanLogin> createState() => _HalamanLoginState();
}

class _HalamanLoginState extends State<HalamanLogin> {
  final _form = GlobalKey<FormState>();
  final _email = TextEditingController();
  final _sandi = TextEditingController();
  bool _sibuk = false;
  bool _sembunyikanSandi = true;
  String? _galat;

  @override
  void dispose() {
    _email.dispose();
    _sandi.dispose();
    super.dispose();
  }

  Future<void> _masuk() async {
    if (_sibuk || !(_form.currentState?.validate() ?? false)) return;
    setState(() {
      _sibuk = true;
      _galat = null;
    });
    FocusScope.of(context).unfocus();

    try {
      final akun = await SesiAkun.periksaKredensial(
        email: _email.text,
        kataSandi: _sandi.text,
      );
      if (!mounted || ModalRoute.of(context)?.isCurrent != true) return;
      if (akun == null) {
        setState(() => _galat = 'Email atau kata sandi tidak sesuai.');
        return;
      }

      SesiAkun.aktifkan(akun);
      Navigator.of(context).pushNamedAndRemoveUntil<Object?>('/', (_) => false);
    } catch (_) {
      if (!mounted) return;
      setState(() => _galat = 'Akun belum dapat dimuat. Coba masuk kembali.');
    } finally {
      if (mounted) setState(() => _sibuk = false);
    }
  }

  @override
  Widget build(BuildContext context) {
    final tema = Theme.of(context);
    return Scaffold(
      body: SafeArea(
        child: ListView(
          padding: const EdgeInsets.symmetric(horizontal: 20, vertical: 36),
          children: [
            Align(
              alignment: Alignment.topCenter,
              child: ConstrainedBox(
                constraints: const BoxConstraints(maxWidth: 480),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.stretch,
                  children: [
                    Text(
                      'G Glow Up Bandung',
                      style: tema.textTheme.titleLarge?.copyWith(
                        color: tema.colorScheme.primary,
                        fontWeight: FontWeight.w800,
                      ),
                    ),
                    const SizedBox(height: 22),
                    Card(
                      child: Padding(
                        padding: const EdgeInsets.all(24),
                        child: Form(
                          key: _form,
                          child: Column(
                            crossAxisAlignment: CrossAxisAlignment.stretch,
                            children: [
                              Text('Masuk', style: tema.textTheme.headlineSmall),
                              const SizedBox(height: 8),
                              const Text('Masuk dengan akun demo Glow Up Bandung.'),
                              const SizedBox(height: 22),
                              TextFormField(
                                controller: _email,
                                enabled: !_sibuk,
                                autocorrect: false,
                                keyboardType: TextInputType.emailAddress,
                                textInputAction: TextInputAction.next,
                                decoration: const InputDecoration(labelText: 'Email'),
                                validator: (nilai) {
                                  if (nilai == null || nilai.trim().isEmpty) {
                                    return 'Masukkan email akun.';
                                  }
                                  return null;
                                },
                              ),
                              const SizedBox(height: 14),
                              TextFormField(
                                controller: _sandi,
                                enabled: !_sibuk,
                                obscureText: _sembunyikanSandi,
                                enableSuggestions: false,
                                autocorrect: false,
                                textInputAction: TextInputAction.done,
                                onFieldSubmitted: (_) => _masuk(),
                                decoration: InputDecoration(
                                  labelText: 'Kata sandi',
                                  suffixIcon: IconButton(
                                    tooltip: _sembunyikanSandi
                                        ? 'Tampilkan kata sandi'
                                        : 'Sembunyikan kata sandi',
                                    onPressed: _sibuk ? null : () {
                                      setState(() => _sembunyikanSandi = !_sembunyikanSandi);
                                    },
                                    icon: Icon(_sembunyikanSandi
                                        ? Icons.visibility_outlined
                                        : Icons.visibility_off_outlined),
                                  ),
                                ),
                                validator: (nilai) {
                                  if (nilai == null || nilai.isEmpty) {
                                    return 'Masukkan kata sandi.';
                                  }
                                  return null;
                                },
                              ),
                              if (_galat case final pesan?) ...[
                                const SizedBox(height: 12),
                                Text(pesan, style: TextStyle(color: tema.colorScheme.error)),
                              ],
                              const SizedBox(height: 18),
                              FilledButton(
                                onPressed: _sibuk ? null : _masuk,
                                child: Text(_sibuk ? 'Memeriksa akun…' : 'Masuk'),
                              ),
                            ],
                          ),
                        ),
                      ),
                    ),
                    const SizedBox(height: 12),
                    Card(
                      child: ExpansionTile(
                        title: const Text('Lihat akun demo'),
                        childrenPadding: const EdgeInsets.fromLTRB(16, 0, 16, 16),
                        expandedCrossAxisAlignment: CrossAxisAlignment.stretch,
                        children: [
                          const SelectableText('Kata sandi semua akun demo ${SesiAkun.kataSandiDemo}'),
                          const SizedBox(height: 12),
                          for (final akun in SesiAkun.daftarDemo.entries)
                            Padding(
                              padding: const EdgeInsets.only(bottom: 6),
                              child: SelectableText('${akun.value.label} · ${akun.key}'),
                            ),
                        ],
                      ),
                    ),
                  ],
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }
}