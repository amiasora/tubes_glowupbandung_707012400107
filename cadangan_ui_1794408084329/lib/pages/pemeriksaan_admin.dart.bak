
import 'dart:typed_data';

import 'package:flutter/material.dart';
import 'package:image/image.dart' as img;
import 'package:latlong2/latlong.dart';

import '../db/database_helper.dart';
import '../models/klarifikasi_laporan.dart';
import '../models/laporan_sampah.dart';
import '../models/verifikasi_laporan.dart';
import '../services/sesi_akun.dart';
import '../widgets/kerangka_warga.dart';
import 'jadwal_operasional.dart';
import 'klarifikasi_warga.dart';
import 'pilih_lokasi_laporan.dart';

class PemeriksaanAdmin extends StatefulWidget {
  const PemeriksaanAdmin({
    super.key,
    required this.akun,
    required this.idLaporan,
  });

  static const rute = '/admin/pemeriksaan';

  final AkunAktif akun;
  final int idLaporan;

  @override
  State<PemeriksaanAdmin> createState() => _PemeriksaanAdminState();
}

enum _TahapPemeriksaan {
  bukti('Pemeriksaan Laporan'),
  checklist('Checklist Verifikasi'),
  keputusan('Keputusan Verifikasi');

  const _TahapPemeriksaan(this.judul);
  final String judul;
}

class _PemeriksaanAdminState extends State<PemeriksaanAdmin> {
  final _db = DatabaseHelper.instance;
  final _form = GlobalKey<FormState>();
  final _nilai = <IndikatorVerifikasi, NilaiChecklist>{};
  final _temuan = {
    for (final indikator in IndikatorVerifikasi.values)
      indikator: TextEditingController(),
  };
  final _catatan = TextEditingController();
  final _alasan = TextEditingController();
  final _kebutuhan = TextEditingController();
  final _kodeUtama = TextEditingController();
  late Future<BahanPemeriksaan?> _bahan;
  _TahapPemeriksaan _tahap = _TahapPemeriksaan.bukti;
  HasilVerifikasi? _hasil;
  int? _idLokasiPilihan;
  bool _menyimpan = false;
  bool _perluMuatUlang = false;
  String? _galat;

  @override
  void initState() {
    super.initState();
    _bahan = _ambil();
  }

  Future<BahanPemeriksaan?> _ambil() => _db.ambilBahanPemeriksaan(
    idAdmin: widget.akun.id,
    idLaporan: widget.idLaporan,
  );

  @override
  void dispose() {
    for (final controller in _temuan.values) {
      controller.dispose();
    }
    _catatan.dispose();
    _alasan.dispose();
    _kebutuhan.dispose();
    _kodeUtama.dispose();
    super.dispose();
  }

  void _pindah(_TahapPemeriksaan tahap) {
    setState(() {
      _tahap = tahap;
      _galat = null;
    });
  }

  void _muatUlang() {
    setState(() {
      _bahan = _ambil();
      _tahap = _TahapPemeriksaan.bukti;
      _perluMuatUlang = false;
      _idLokasiPilihan = null;
      _galat = null;
    });
  }

  Future<void> _simpan(BahanPemeriksaan bahan) async {
    if (_menyimpan || _perluMuatUlang || !(_form.currentState?.validate() ?? false)) {
      return;
    }
    final hasil = _hasil;
    if (hasil == null || !identical(SesiAkun.aktif, widget.akun)) return;

    setState(() {
      _menyimpan = true;
      _galat = null;
    });
    try {
      await _db.simpanVerifikasi(
        idAdmin: widget.akun.id,
        idLaporan: widget.idLaporan,
        versi: bahan.versi,
        hasil: hasil,
        alasan: _alasan.text,
        catatan: _catatan.text,
        kebutuhanKlarifikasi: _kebutuhan.text,
        kodeLaporanUtama: _kodeUtama.text,
        idUsulanLokasi: hasil == HasilVerifikasi.valid && _idLokasiPilihan != 0
            ? _idLokasiPilihan : null,
        checklist: {
          for (final indikator in IndikatorVerifikasi.values)
            indikator: (
              hasil: _nilai[indikator]!,
              temuan: _temuan[indikator]!.text,
            ),
        },
      );
      if (!mounted) return;
      _muatUlang();
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('Keputusan tersimpan · ${hasil.statusBaru}')),
      );
    } on GalatVerifikasi catch (galat) {
      if (!mounted) return;
      setState(() {
        _galat = galat.pesan;
        _perluMuatUlang = galat.muatUlang;
      });
    } catch (_) {
      if (!mounted) return;
      setState(() {
        _galat = 'Keputusan belum tersimpan. Coba simpan kembali.';
      });
    } finally {
      if (mounted) setState(() => _menyimpan = false);
    }
  }

  @override
  Widget build(BuildContext context) {
    return PopScope(
      canPop: !_menyimpan,
      child: KerangkaPeran(
        peran: PeranAkun.admin,
        ruteAktif: PemeriksaanAdmin.rute,
        menu: const {'/': 'Dashboard', '/admin/laporan': 'Daftar Laporan'},
        navigasiAktif: !_menyimpan,
        child: FutureBuilder<BahanPemeriksaan?>(
          future: _bahan,
          builder: (context, snapshot) {
            if (snapshot.connectionState == ConnectionState.waiting) {
              return const Center(child: CircularProgressIndicator());
            }
            final bahan = snapshot.data;
            if (snapshot.hasError || bahan == null) {
              return KontenWarga(children: [
                const JudulHalamanWarga(judul: 'Pemeriksaan Laporan'),
                Text(snapshot.hasError
                    ? 'Bukti belum dapat dibaca.'
                    : 'Laporan tidak ditemukan.'),
                OutlinedButton(onPressed: _muatUlang, child: const Text('Muat ulang')),
                TextButton(onPressed: _kembali, child: const Text('Kembali')),
              ]);
            }
            return KeyedSubtree(
              key: ValueKey(_tahap),
              child: KontenWarga(children: [
                JudulHalamanWarga(
                  judul: _tahap.judul,
                  deskripsi: 'Bukti  /  Checklist  /  Keputusan',
                ),
                _Panel(
                  judul: bahan.laporan.kodeLaporan ?? 'Laporan',
                  children: [
                    Wrap(spacing: 8, runSpacing: 8, children: [
                      Chip(label: Text(bahan.laporan.statusPenanganan.nilaiDatabase)),
                      if (bahan.keputusan.isNotEmpty)
                        Chip(label: Text('${bahan.keputusan.first['hasil']}')),
                    ]),
                  ],
                ),
                ...switch (_tahap) {
                  _TahapPemeriksaan.bukti => _bukti(bahan),
                  _TahapPemeriksaan.checklist => _checklist(),
                  _TahapPemeriksaan.keputusan => _keputusan(bahan),
                },
              ]),
            );
          },
        ),
      ),
    );
  }

  Future<void> _bukaJadwal(BahanPemeriksaan bahan) async {
    final disimpan = await Navigator.push<bool>(
      context,
      MaterialPageRoute(builder: (_) => JadwalAdmin(
        akun: widget.akun,
        idLaporan: widget.idLaporan,
        kodeLaporan: bahan.laporan.kodeLaporan ?? 'Laporan',
        versiLaporan: bahan.versi,
      )),
    );
    if (!mounted) return;
    _muatUlang();
    if (disimpan == true) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Jadwal dan penugasan tersimpan.')),
      );
    }
  }

  void _kembali() => Navigator.of(context).maybePop();

  KlarifikasiLaporan? _usulanLokasi(BahanPemeriksaan bahan) {
    for (final data in bahan.klarifikasi) {
      if (data.lokasiUsulan != null) return data;
    }
    return null;
  }

  List<Widget> _bukti(BahanPemeriksaan bahan) {
    final laporan = bahan.laporan;
    final titik = LatLng(laporan.latitude, laporan.longitude);
    final status = laporan.statusPenanganan.nilaiDatabase;
    final bisaTinjau = status == HasilVerifikasi.perluVerifikasi.statusBaru &&
        bahan.klarifikasi.any((data) =>
            data.idPermintaan == laporan.idVerifikasiTerakhir && data.idTindakLanjut == null);
    final usulan = _usulanLokasi(bahan)?.lokasiUsulan;
    final valid = bahan.keputusan.isNotEmpty &&
        bahan.keputusan.first['hasil'] == HasilVerifikasi.valid.label;
    return [
      if (valid && status == 'Diterima')
        FilledButton.icon(
          onPressed: () => _bukaJadwal(bahan),
          icon: const Icon(Icons.event_available_outlined),
          label: const Text('Jadwalkan Pengangkutan'),
        ),
      if (valid && status == 'Diproses')
        OutlinedButton.icon(
          onPressed: () => _bukaJadwal(bahan),
          icon: const Icon(Icons.calendar_today_outlined),
          label: const Text('Lihat Jadwal Pengangkutan'),
        ),
      _Panel(judul: 'Deskripsi dan jenis sampah', children: [
        Text(bahan.kategori),
        SelectableText(laporan.deskripsiLaporan),
        Text(bahan.jenis.map((item) => item.namaJenis).join(', ')),
      ]),
      _Panel(judul: 'Foto asli', children: [
        if (bahan.foto.isEmpty) const Text('Foto tidak tersedia.'),
        Wrap(spacing: 12, runSpacing: 12, children: [
          for (final bukti in bahan.foto)
            _FotoPemeriksaan(
              nama: bukti.foto.namaBerkas,
              bytes: Uint8List.fromList(bukti.foto.dataFoto),
              diunggah: bukti.diunggah,
            ),
        ]),
      ]),
      _Panel(judul: 'Lokasi kejadian dan waktu pengiriman', children: [
        SelectableText('${laporan.kecamatan} · ${laporan.deskripsiLokasi}'),
        SelectableText('${laporan.latitude.toStringAsFixed(6)}, '
            '${laporan.longitude.toStringAsFixed(6)}'),
        Text(laporan.metodeLokasi == MetodeLokasi.perangkat
            ? 'Sumber pin · Lokasi perangkat'
            : 'Sumber pin · Titik pada peta'),
        Text('Lokasi dikonfirmasi · ${waktuWibWarga(laporan.lokasiDikonfirmasiAtUtc)}'),
        Text('Laporan tersimpan · ${waktuWibWarga(laporan.dibuatAtUtc)}'),
        SizedBox(
          height: 300,
          child: ClipRRect(
            borderRadius: BorderRadius.circular(8),
            child: PetaLaporan(pusatAwal: titik, titik: titik),
          ),
        ),
      ]),
      if (bahan.klarifikasi.isNotEmpty) ...[
        for (final data in bahan.klarifikasi)
          KartuRiwayatKlarifikasi(klarifikasi: data),
        if (bisaTinjau && usulan != null)
          _Panel(judul: 'Peta usulan lokasi terbaru', children: [
            Text('${usulan.kecamatan} · ${usulan.patokan}'),
            SizedBox(
              height: 260,
              child: PetaLaporan(
                pusatAwal: LatLng(usulan.latitude, usulan.longitude),
                titik: LatLng(usulan.latitude, usulan.longitude),
              ),
            ),
          ]),
      ],
      _Panel(judul: 'Laporan pembanding', children: [
        const Text('Maksimal delapan laporan terbaru pada kecamatan yang sama. '
            'Bandingkan kejadian, lokasi, waktu dan bukti secara manual.'),
        if (bahan.pembanding.isEmpty)
          const Text('Belum ada laporan lain pada kecamatan ini.'),
        for (final item in bahan.pembanding)
          SelectableText('${item['kode_laporan']} · ${item['status_penanganan']}\n'
              '${item['deskripsi_lokasi']} · '
              '${waktuWibWarga(DateTime.parse(item['dibuat_at_utc'] as String))}'),
      ]),
      if (bahan.keputusan.isNotEmpty) ...[
        for (final item in bahan.keputusan)
          _Panel(judul: 'Riwayat keputusan · ${item['hasil']}', children: [
            Text('${item['nama_admin']} · '
                '${waktuWibWarga(DateTime.parse(item['diperiksa_at_utc'] as String))}'),
            Text('Alasan · ${item['alasan']}'),
            if ((item['catatan'] as String).isNotEmpty) Text('Catatan · ${item['catatan']}'),
            if (item['kebutuhan_klarifikasi'] != null)
              Text('Kebutuhan klarifikasi · ${item['kebutuhan_klarifikasi']}'),
            if (item['kode_utama'] != null) Text('Laporan utama · ${item['kode_utama']}'),
            for (final baris in bahan.checklist)
              if (baris['id_verifikasi'] == item['id_verifikasi'])
                Text('${IndikatorVerifikasi.values.byName(baris['indikator'] as String).label}'
                    ' · ${baris['hasil']}'
                    '${(baris['temuan'] as String).isEmpty ? '' : '\n${baris['temuan']}'}'),
          ]),
      ],
      for (final aktivitas in bahan.aktivitas)
        KartuAktivitasPengangkutan(aktivitas: aktivitas),
      _Panel(judul: 'Perkembangan laporan', children: [
        for (final item in bahan.riwayatStatus)
          Text('${item['status_lama'] ?? 'Laporan dikirim'} → ${item['status_baru']}\n'
              '${waktuWibWarga(DateTime.parse(item['diubah_at_utc'] as String))}'),
      ]),
      if (laporan.statusPenanganan == StatusPenanganan.baru || bisaTinjau)
        FilledButton(
          onPressed: () => _pindah(_TahapPemeriksaan.checklist),
          child: Text(bisaTinjau ? 'Periksa Ulang Klarifikasi' : 'Lanjut ke Checklist'),
        )
      else if (status == HasilVerifikasi.perluVerifikasi.statusBaru)
        const _Panel(judul: 'Menunggu jawaban Warga', children: [
          Text('Pemeriksaan ulang tersedia setelah pemilik laporan mengirim klarifikasi.'),
        ]),
      TextButton(onPressed: _kembali, child: const Text('Kembali ke daftar')),
    ];
  }

  List<Widget> _checklist() => [
    for (final indikator in IndikatorVerifikasi.values)
      _Panel(judul: indikator.label, children: [
        Text(indikator.petunjuk),
        Wrap(spacing: 8, runSpacing: 8, children: [
          for (final nilai in NilaiChecklist.values)
            ChoiceChip(
              label: Text(nilai.label),
              selected: _nilai[indikator] == nilai,
              onSelected: (_) => setState(() {
                _nilai[indikator] = nilai;
                _galat = null;
              }),
            ),
        ]),
        TextField(
          controller: _temuan[indikator],
          decoration: const InputDecoration(labelText: 'Catatan temuan'),
          maxLength: 2000,
          maxLines: 2,
        ),
      ]),
    if (_galat != null) _pesanGalat(),
    FilledButton(
      onPressed: () {
        if (_nilai.length == IndikatorVerifikasi.values.length) {
          _pindah(_TahapPemeriksaan.keputusan);
        } else {
          setState(() => _galat = 'Pilih hasil untuk keenam indikator.');
        }
      },
      child: const Text('Lanjut ke Keputusan'),
    ),
    TextButton(
      onPressed: () => _pindah(_TahapPemeriksaan.bukti),
      child: const Text('Kembali ke bukti'),
    ),
  ];

  List<Widget> _keputusan(BahanPemeriksaan bahan) {
    final usulan = _usulanLokasi(bahan);
    return [
      Form(
        key: _form,
        child: _Panel(judul: 'Simpan hasil pemeriksaan', children: [
          Text('Pemeriksa · ${widget.akun.nama}'),
          _kolom(_catatan, 'Catatan verifikasi'),
          DropdownButtonFormField<HasilVerifikasi>(
            initialValue: _hasil,
            isExpanded: true,
            decoration: const InputDecoration(labelText: 'Hasil verifikasi'),
            items: [
              for (final hasil in HasilVerifikasi.values)
                DropdownMenuItem(value: hasil, child: Text(hasil.label)),
            ],
            onChanged: _menyimpan ? null : (hasil) => setState(() => _hasil = hasil),
            validator: (hasil) => hasil == null ? 'Pilih hasil verifikasi.' : null,
          ),
          if (_hasil case final hasil?)
            Text('Status setelah simpan · ${hasil.statusBaru}'),
          if (_hasil == HasilVerifikasi.valid && usulan != null)
            DropdownButtonFormField<int>(
              initialValue: _idLokasiPilihan,
              isExpanded: true,
              decoration: const InputDecoration(labelText: 'Titik yang disetujui'),
              items: [
                const DropdownMenuItem(value: 0, child: Text('Titik laporan saat ini')),
                DropdownMenuItem(
                  value: usulan.id,
                  child: const Text('Usulan terbaru dari Warga'),
                ),
              ],
              onChanged: _menyimpan ? null : (id) => setState(() => _idLokasiPilihan = id),
              validator: (id) => id == null ? 'Pilih titik yang akan dipakai Petugas.' : null,
            ),
          _kolom(_alasan, 'Alasan keputusan', wajib: true),
          if (_hasil == HasilVerifikasi.perluVerifikasi)
            _kolom(_kebutuhan, 'Informasi yang perlu dilengkapi warga', wajib: true),
          if (_hasil == HasilVerifikasi.duplikat)
            _kolom(_kodeUtama, 'Kode laporan utama', wajib: true, panjang: 30),
        ]),
      ),
      if (_galat != null) _pesanGalat(),
      if (_perluMuatUlang)
        OutlinedButton(onPressed: _muatUlang, child: const Text('Muat laporan terbaru'))
      else
        FilledButton(
          onPressed: _menyimpan ? null : () => _simpan(bahan),
          child: Text(_menyimpan ? 'Menyimpan…' : 'Simpan Keputusan'),
        ),
      TextButton(
        onPressed: _menyimpan ? null : () => _pindah(_TahapPemeriksaan.checklist),
        child: const Text('Kembali ke checklist'),
      ),
    ];
  }

  Widget _kolom(TextEditingController controller, String label, {
    bool wajib = false,
    int panjang = 2000,
  }) => TextFormField(
    controller: controller,
    enabled: !_menyimpan,
    maxLines: panjang == 30 ? 1 : 3,
    maxLength: panjang,
    decoration: InputDecoration(labelText: label),
    validator: (teks) => wajib && (teks?.trim().isEmpty ?? true)
        ? 'Bagian ini wajib diisi.'
        : null,
  );

  Widget _pesanGalat() => Padding(
    padding: const EdgeInsets.only(bottom: 12),
    child: Text(_galat!, style: TextStyle(color: Theme.of(context).colorScheme.error)),
  );
}

class _Panel extends StatelessWidget {
  const _Panel({required this.judul, required this.children});

  final String judul;
  final List<Widget> children;

  @override
  Widget build(BuildContext context) => Card(
    margin: const EdgeInsets.only(bottom: 14),
    child: Padding(
      padding: const EdgeInsets.all(18),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.stretch,
        spacing: 10,
        children: [
          Text(judul, style: Theme.of(context).textTheme.titleMedium),
          ...children,
        ],
      ),
    ),
  );
}

class _FotoPemeriksaan extends StatelessWidget {
  const _FotoPemeriksaan({
    required this.nama,
    required this.bytes,
    required this.diunggah,
  });

  final String nama;
  final Uint8List bytes;
  final DateTime diunggah;

  void _buka(BuildContext context) {
    final metadata = _bacaExif(bytes);
    final waktuFoto = metadata?.exifIfd[0x9003]?.toString().trim();
    final zona = metadata?.exifIfd[0x9011]?.toString().trim();
    final gps = metadata?.gpsIfd;
    final latitude = _derajat(gps?[2], gps?[1]?.toString(), 'N', 'S', 90);
    final longitude = _derajat(gps?[4], gps?[3]?.toString(), 'E', 'W', 180);
    final koordinat = latitude == null || longitude == null
        ? 'Belum dapat dinilai'
        : '${latitude.toStringAsFixed(6)}, ${longitude.toStringAsFixed(6)}';
    final waktu = waktuFoto == null || waktuFoto.isEmpty
        ? 'Belum dapat dinilai'
        : '$waktuFoto · ${zona == null || zona.isEmpty ? 'zona tidak tercatat' : zona}';

    showDialog<void>(
      context: context,
      builder: (context) => AlertDialog(
        title: const Text('Foto asli dan metadata'),
        scrollable: true,
        content: SizedBox(
          width: 640,
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            spacing: 8,
            children: [
              SizedBox(height: 280, child: InteractiveViewer(
                child: Center(child: _gambar(BoxFit.contain)),
              )),
              SelectableText(nama),
              Text('Foto tersimpan · ${waktuWibWarga(diunggah)}'),
              Text('Waktu pengambilan (EXIF) · $waktu'),
              Text('Koordinat kamera (EXIF) · $koordinat'),
              const Text('Metadata foto dibaca sebagai bukti pendukung. '
                  'Bandingkan dengan titik kejadian dan keterangan warga.'),
            ],
          ),
        ),
        actions: [
          TextButton(onPressed: () => Navigator.pop(context), child: const Text('Tutup')),
        ],
      ),
    );
  }

  static img.ExifData? _bacaExif(Uint8List bytes) {
    try {
      if (bytes.length < 8) return null;
      if (bytes[0] == 0xff && bytes[1] == 0xd8) return img.decodeJpgExif(bytes);
      const tandaPng = [137, 80, 78, 71, 13, 10, 26, 10];
      for (var indeks = 0; indeks < tandaPng.length; indeks++) {
        if (bytes[indeks] != tandaPng[indeks]) return null;
      }
      final data = ByteData.sublistView(bytes);
      var posisi = 8;
      while (posisi + 12 <= bytes.length) {
        final panjang = data.getUint32(posisi);
        final awal = posisi + 8;
        final akhir = awal + panjang;
        if (akhir + 4 > bytes.length) return null;
        final tipe = data.getUint32(posisi + 4);
        if (tipe == 0x65584966) { // eXIf
          return img.ExifData.fromInputBuffer(
            img.InputBuffer(Uint8List.sublistView(bytes, awal, akhir)),
          );
        }
        if (tipe == 0x49454e44) return null; // IEND
        posisi = akhir + 4;
      }
    } catch (_) {
      return null;
    }
    return null;
  }

  static double? _derajat(
    img.IfdValue? data,
    String? arah,
    String positif,
    String negatif,
    int batas,
  ) {
    final referensi = arah?.trim().toUpperCase();
    if (data == null || data.length != 3 ||
        (referensi != positif && referensi != negatif)) {
      return null;
    }
    try {
      final derajat = data.toDouble(0);
      final menit = data.toDouble(1);
      final detik = data.toDouble(2);
      if (derajat < 0 || menit < 0 || menit >= 60 || detik < 0 || detik >= 60) {
        return null;
      }
      final nilai = derajat + menit / 60 + detik / 3600;
      if (!nilai.isFinite || nilai > batas) return null;
      return referensi == negatif ? -nilai : nilai;
    } catch (_) {
      return null;
    }
  }

  Widget _gambar(BoxFit fit) => Image.memory(
    bytes,
    fit: fit,
    errorBuilder: (_, error, stackTrace) => const Center(
      child: Text('Pratinjau foto tidak dapat dibuka'),
    ),
  );

  @override
  Widget build(BuildContext context) => SizedBox(
    width: 240,
    child: Column(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      children: [
        SizedBox(
          height: 145,
          child: ClipRRect(borderRadius: BorderRadius.circular(8), child: _gambar(BoxFit.cover)),
        ),
        Text(nama, overflow: TextOverflow.ellipsis),
        OutlinedButton.icon(
          onPressed: () => _buka(context),
          icon: const Icon(Icons.image_search_outlined, size: 18),
          label: const Text('Buka Foto dan EXIF'),
        ),
      ],
    ),
  );
}



